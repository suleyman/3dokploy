# All optional. Copy to .env (or set in your container / Dokploy env).

# Port for the app + relay
# PORT=3000

# --- Pin this instance to one Dokploy (self-hosting) -------------------------------------
# With only DOKPLOY_URL, visitors just paste their API key (kept in their browser).
# With DOKPLOY_API_KEY too, the connect screen is skipped and the key never leaves the server.
# Either way the relay then talks to this Dokploy only; private addresses are fine here.
# DOKPLOY_URL=https://dokploy.example.com
# DOKPLOY_API_KEY=

# Password-protect the whole site (strongly recommended when DOKPLOY_API_KEY is set)
# BASIC_AUTH=admin:change-me

# --- Open (unpinned) instances ------------------------------------------------------------
# By default every user's Dokploy URL and API key stay in their browser and only pass through
# the relay, per request, never stored or logged.

# Let the relay reach private / LAN addresses (10.x, 192.168.x, localhost…).
# Only for setups that are not public: on a public host this would be an SSRF hole.
# ALLOW_PRIVATE_TARGETS=1

# Relay requests per minute per client IP
# RATE_LIMIT_PER_MIN=1200
