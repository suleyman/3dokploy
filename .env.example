# Copy to .env.local (or set these in your container / Dokploy environment).

# --- Required ---------------------------------------------------------------------------
# Your Dokploy. On the same machine as a container: http://host.docker.internal:3000
DOKPLOY_URL=https://dokploy.example.com
# Dokploy → Settings → Profile → API/CLI. Stays on this server; the browser never sees it.
DOKPLOY_API_KEY=

# --- Optional ---------------------------------------------------------------------------
# Password-protect the page (recommended whenever others can reach it)
# BASIC_AUTH=admin:change-me

# Port this server listens on
# PORT=3000

# Uptime Kuma: a monitor that is down on one of a service's domains sets that node in error.
# Kuma → Settings → API Keys. Read from Kuma's /metrics; stays on this server.
# KUMA_URL=http://host.docker.internal:3001
# KUMA_API_KEY=

# --- More optional integrations (each is off until set; all read-only) ---------------------
# GlitchTip / Sentry: unresolved issues per project → sparks and an error badge on the rack
# GLITCHTIP_URL=https://errors.example.com
# GLITCHTIP_TOKEN=
# Umami: active visitors per website → people walking in through the gate
# UMAMI_URL=https://stats.example.com
# UMAMI_API_KEY=
# CrowdSec LAPI with a bouncer key (cscli bouncers add 3dokploy) → blocks at the gate
# CROWDSEC_URL=http://crowdsec:8080
# CROWDSEC_BOUNCER_KEY=
# A docker-socket-proxy with CONTAINERS=1 only → container log lines in the inspector
# DOCKER_PROXY_URL=http://docker-proxy:2375
# JSON from a conntrack sidecar: [{"s","d","p","n"}] (source IP, target IP, port, connections) → who talks to whom
# FLOW_STATUS_FILE=/status/flows.json
# JSON written by a sidecar: [{"name","newest","size","files"}] per backup folder → backup vault
# BACKUP_STATUS_FILE=/status/backups.json
# Building order, complexes and colours (mount a volume here to keep them)
# PREFS_FILE=/data/prefs.json
