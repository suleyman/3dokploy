# Copy to .env.local (or set these in your container / Dokploy environment).

# --- Required ---------------------------------------------------------------------------
# Your Dokploy. On the same machine as a container: http://host.docker.internal:3000
DOKPLOY_URL=https://dokploy.example.com
# Dokploy → Settings → Profile → API/CLI. Stays on this server; the browser never sees it.
DOKPLOY_API_KEY=

# --- Optional ---------------------------------------------------------------------------
# Password-protect the page (recommended whenever others can reach it)
# BASIC_AUTH=admin:change-me

# Sites allowed to embed the page in an iframe (CSP frame-ancestors). Default: nobody.
# For AbleSign: FRAME_ANCESTORS=https://*.ablesign.tv
# FRAME_ANCESTORS=

# Port this server listens on
# PORT=3000
